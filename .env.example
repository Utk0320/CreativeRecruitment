# ==============================================================================
# CreativeRecruit Environment Configuration Template
# For local development: copy to `backend/.env`
# For Render deployment: add these in Render Dashboard -> Web Service -> Environment
# ==============================================================================

# Node Environment ('development' locally, 'production' on Render)
NODE_ENV=production

# Server Port (Render sets this automatically to 10000)
PORT=10000

# Server Host (0.0.0.0 is required for container deployments on Render)
HOST=0.0.0.0

# Security: Random secret key of at least 32 characters for signing JWT tokens
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters

# Timezone for application scheduling
TIMEZONE=Asia/Kolkata

# Database: path to the SQLite database file
DATABASE_PATH=./database/creativerecruit.db

# ------------------------------------------------------------------------------
# Frontend & CORS Configuration
# ------------------------------------------------------------------------------
# In production on Render: must be the HTTPS URL of your frontend Static Site
FRONTEND_URL=https://your-frontend-service.onrender.com

# Allowed CORS origins (comma-separated HTTPS URLs in production)
CORS_ORIGIN=https://your-frontend-service.onrender.com

# Cookie settings for cross-site Render deployments (frontend & backend on separate subdomains)
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# Email Delivery Configuration (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# 'smtp' is REQUIRED in production (NODE_ENV=production). 'console' is only allowed in development.
EMAIL_PROVIDER=smtp

# SMTP server hostname (e.g., smtp.gmail.com, smtp.resend.com, smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com

# SMTP port: 587 (standard STARTTLS) or 465 (SSL/TLS direct)
SMTP_PORT=587

# SMTP secure connection: 'false' for port 587, 'true' for port 465
SMTP_SECURE=false

# SMTP username / login email (e.g. your Gmail address or 'resend' or 'apikey')
SMTP_USER=your-email@gmail.com

# SMTP password / App password / API key (e.g. Google 16-character App Password)
SMTP_PASSWORD=your_smtp_app_password

# Sender address shown in outgoing emails
EMAIL_FROM=your-email@gmail.com

# ------------------------------------------------------------------------------
# Single Sign-On (SSO) Configuration (Optional)
# ------------------------------------------------------------------------------
SSO_PROVIDER=none
GOOGLE_CLIENT_ID=
MICROSOFT_TENANT_ID=

# ------------------------------------------------------------------------------
# First Admin Account Creation (Optional for non-interactive `npm run create-admin`)
# ------------------------------------------------------------------------------
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

