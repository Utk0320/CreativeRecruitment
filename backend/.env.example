# ==============================================================================
# CreativeRecruit Backend Environment Configuration
# ==============================================================================

# Node Environment ('development' locally, 'production' on Render)
NODE_ENV=development

# Server Port (5000 locally, Render sets this automatically to 10000)
PORT=5000

# Server Host (0.0.0.0 binds to all network interfaces)
HOST=0.0.0.0

# Security: Random secret key of at least 32 characters for signing JWT tokens
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters

# Timezone for application scheduling
TIMEZONE=Asia/Kolkata

# Database: path to the SQLite database file
DATABASE_PATH=./database/creativerecruit.db

# ------------------------------------------------------------------------------
# Frontend & CORS Configuration
# ------------------------------------------------------------------------------
# Locally: http://localhost:5173
# On Render: https://your-frontend-service.onrender.com
FRONTEND_URL=http://localhost:5173

# Allowed CORS origins (comma-separated URLs)
CORS_ORIGIN=http://localhost:5173

# Cookie settings ('lax' locally; 'none' with COOKIE_SECURE=true on Render)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=auto
COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# Email Delivery Configuration
# ------------------------------------------------------------------------------
# 'console' is allowed locally in development. In production, 'smtp' is STRICTLY REQUIRED.
EMAIL_PROVIDER=console

# In production (EMAIL_PROVIDER=smtp), configure your real SMTP server details:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# ------------------------------------------------------------------------------
# Single Sign-On (SSO) Configuration (Optional)
# ------------------------------------------------------------------------------
SSO_PROVIDER=none
GOOGLE_CLIENT_ID=
MICROSOFT_TENANT_ID=

# ------------------------------------------------------------------------------
# First Admin Account Creation (Optional for non-interactive `npm run create-admin`)
# ------------------------------------------------------------------------------
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
